datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id         String   @id
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  payload    Json
}

model PricingItem {
  sku         String @id
  name        String
  description String
  unit        String
  price       Float
  vendor      String
  category    String
}
